{
  "name": "stahlbunker-1945",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx --tsconfig server/tsconfig.json server/src/index.ts",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate:p1:network": "tsx scripts/p1-network-gate.ts",
    "gate:p2:network": "tsx scripts/p2-network-gate.ts",
    "gate:p3:network": "tsx scripts/p3-network-gate.ts",
    "gate:p4:network": "tsx scripts/p4-network-gate.ts",
    "gate:p5:network": "tsx scripts/p5-network-gate.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "start:server": "node dist-server/server/src/index.js"
  },
  "dependencies": {
    "@colyseus/schema": "4.0.27",
    "@colyseus/sdk": "0.17.43",
    "colyseus": "0.17.10",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "26.1.1",
    "@types/three": "0.185.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
